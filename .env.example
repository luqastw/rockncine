# Postgres (Neon ou Supabase, free tier) — ver docs/specs/01-fundacao-mvp/spec.md, seção 6
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# gerado local: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Liveblocks project (free tier) — usado só no servidor
LIVEBLOCKS_SECRET_KEY=""

# LiveKit Cloud — SFU do modo transmissão por screen share
# (docs/specs/12-transmissao-screen-share/spec.md, seção 7). As três faltando
# NÃO quebram o app: a sala fica no modo player e o botão de transmitir não
# aparece (lib/livekit.ts). Todos os valores saem do painel do projeto, em
# https://cloud.livekit.io — o mesmo projeto serve todas as salas, e a room do
# Livekit é nomeada com o código da sala.
#
# URL pública do projeto (o `wss://<subdomain>.livekit.cloud` da página de
# conexão). É o único dos três que chega ao navegador, via prop do server
# component — as outras duas nunca saem do servidor.
LIVEKIT_URL=""

# API key e secret da mesma página. Usados só em app/api/livekit-auth/route.ts
# para mintar o token de room; nunca no cliente.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
